{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://11111.life/schemas/project-status.schema.json",
  "title": "11 111 confirmed distance history",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "entries"
  ],
  "properties": {
    "version": {
      "const": 2
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/snapshot"
      }
    }
  },
  "$defs": {
    "localizedRequired": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ru",
        "en"
      ],
      "properties": {
        "ru": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "localizedOptional": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ru",
        "en"
      ],
      "properties": {
        "ru": {
          "type": [
            "string",
            "null"
          ]
        },
        "en": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "verified",
        "updatedAt",
        "distanceKm",
        "discipline",
        "note",
        "source"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "verified": {
          "const": true
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "distanceKm": {
          "type": "number",
          "minimum": 0,
          "maximum": 11111
        },
        "discipline": {
          "$ref": "#/$defs/localizedRequired"
        },
        "note": {
          "$ref": "#/$defs/localizedOptional"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label",
            "url"
          ],
          "properties": {
            "label": {
              "$ref": "#/$defs/localizedRequired"
            },
            "url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            }
          }
        }
      }
    }
  }
}
